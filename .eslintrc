{
  "extends": ["eslint:recommended", "google"],
  "rules": {
    "no-console" : "error",
    "no-debugger": "error",
    "max-len": "off",
    "no-unused-vars": ["warn"],
    "comma-dangle": ["error", {
      "objects": "never"
    }],
    "indent": ["error", 2, {
      "FunctionExpression": {
        "parameters": 2
      }
    }]
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "env": {
    "es6": true,
    "node": true,
    "browser": true,
    "jest": true
  },
  "overrides": [
    {
      "files": ["test/**", "test-e2e/**"],
      "rules": {
        "require-jsdoc": "off",
        "prefer-promise-reject-errors": "off",
        "valid-jsdoc": "off"
      }
    }
  ]
}

